// Rendered to wrangler.jsonc by bootstrap/bootstrap.py. Edit the template, not the output.
{
  "name": "{worker_name}",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  "triggers": { "crons": ["{tick_cron}"] },
  "d1_databases": [
    { "binding": "DB", "database_name": "{d1_database}", "database_id": "{d1_database_id}", "migrations_dir": "../../core/migrations" }
  ],
  "workers_dev": false,
  "observability": { "enabled": true }
}
